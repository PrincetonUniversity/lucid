// Delayed generates. Each ping(x) sends out(100 + x) at once and out(x) after
// 2.5 ms, and recirculates ping(x + 1) after 1 ms, up to x = 2. So the
// undelayed outputs of the three pings come first, 1 ms apart, then the delayed
// ones. The delays are wide enough that the order doesn't depend on how fast the
// program runs: on the DPDK target under x86 emulation, a first packet can take
// over 100 us.
event ping(int<32> x);
event out(int<32> x);

handle ping(int<32> x) {
    generate_port(1, out(100 + x));
    generate_port(1, Event.delay(out(x), 2500000));
    if (x < 2) {
        generate(Event.delay(ping(x + 1), 1000000));
    }
}
