// Delayed generates. Each ping(x) sends out(100 + x) at once and out(x) after
// 250 us, and recirculates ping(x + 1) after 100 us, up to x = 2. So the
// undelayed outputs of the three pings come first, 100 us apart, then the
// delayed ones (the delays are wide enough that the order does not depend on
// how fast the program runs).
event ping(int<32> x);
event out(int<32> x);

handle ping(int<32> x) {
    generate_port(1, out(100 + x));
    generate_port(1, Event.delay(out(x), 250000));
    if (x < 2) {
        generate(Event.delay(ping(x + 1), 100000));
    }
}
