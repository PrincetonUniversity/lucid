// A recirculation that multiplies: each `tick` generates two more, so the
// recirculation queue saturates at once and stays full. Used to test that the
// driver keeps serving fresh input anyway: only recirculated events may be
// dropped (the DPDK driver's recirc_in is drop-tail), never arrivals. Same
// event names as scanloop.dpt, so the test reuses its frames and check.
event tick();
event pkt_in(int x);
event pkt_out(int x) { skip; }

handle tick() {
    generate tick();                // two recirculations per tick: the queue fills
    generate tick();
}

handle pkt_in(int x) {
    generate_port(0, pkt_out(x));   // one output per input packet
}
