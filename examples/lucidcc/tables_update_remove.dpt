// Table.update and Table.remove, plus the operations that leave a table 
// unchanged: installing an entry that is already there, installing into a 
// full table, and updating or removing an entry that is not there 
// (cases/tables_update_remove.json). 
//   do_install(key, val) -- install hit_acn(val) for key
//   do_update(key, val)  -- change key's entry to hit_acn(val)
//   do_remove(key)       -- remove key's entry
//   do_query(key)        -- look key up and emit query_result(key, val, hit) on port 1
// A miss runs the default miss_acn, which echoes the lookup arg (1000).

type res_t = {
  int val;
  bool is_hit;
}

action res_t hit_acn(int x)(int a) {
  return {val = x; is_hit = true};
}
action res_t miss_acn(int b)(int a) {
  return {val = a; is_hit = false};
}

// a table with room for 2 entries
global Table.t<<int, int, int, res_t>> ftbl = Table.create(2, [hit_acn; miss_acn], miss_acn, 1);

// output event: the result of a query, observable in the output pcap
event query_result(int key, int val, int hit) { skip; }

event do_install(int key, int val) {
  Table.install(ftbl, key, hit_acn, val);
}

event do_update(int key, int val) {
  Table.update(ftbl, key, hit_acn, val);
}

event do_remove(int key) {
  Table.remove(ftbl, key);
}

event do_query(int key) {
  res_t r = Table.lookup(ftbl, key, 1000);
  int hit = 0;
  if (r#is_hit == true) {
    hit = 1;
  }
  printf("query key=%d -> val=%d hit=%d", key, r#val, hit);
  generate_port(1, query_result(key, r#val, hit));
}
