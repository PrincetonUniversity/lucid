// A benchmark program: the ethernet reflector (ethswaprefl) plus one table lookup per
// packet, to measure what a table costs as it grows (test/bench_lucidcc). The table maps
// the low 32 bits of the destination MAC to a new ethertype. A hit rewrites the
// ethertype; a miss keeps it. Entries come from do_install events, e.g. a benchmark's
// preload. No printfs: a print per packet costs far more than the table.
packet event ethpkt(int<48> dst, int<48> src, int<16> ety, Payload.t pl);

action int<16> set_ety(int<16> new_ety)(int<16> ety) {
  return new_ety;
}
action int<16> keep_ety(int<16> unused)(int<16> ety) {
  return ety;
}

global Table.t<<int, int<16>, int<16>, int<16>>> ety_tbl = Table.create(4096, [set_ety; keep_ety], keep_ety, 0);

event do_install(int key, int<16> new_ety) {
  Table.install<unordered>(ety_tbl, key, set_ety, new_ety);
}

handle ethpkt(int<48> dst, int<48> src, int<16> ety, Payload.t pl) {
  int<16> out_ety = Table.lookup(ety_tbl, (int<32>)dst, ety);
  generate_port(ingress_port, ethpkt(src, dst, out_ety, pl));
}

parser main(bitstring pkt) {
  int<48> dst = read(pkt);
  int<48> src = read(pkt);
  int<16> ety = read(pkt);
  match ety with
  | LUCID_ETHERTY -> { do_lucid_parsing(pkt); }
  | _ -> { generate ethpkt(dst, src, ety, Payload.parse(pkt)); }
}
